<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <queries>
        <package android:name="cz.o2.oneplay" />
        <package android:name="cz.o2.o2tv" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.youtube" />
        <package android:name="org.xbmc.kodi" />
        <package android:name="cz.ceskatelevize.ivysilani" />
        <package android:name="cz.ceskatelevize.androidtv" />
        <package android:name="cz.motion.ivysilani" />
        <package android:name="com.spotify.tv.android" />
        <package android:name="com.spotify.music" />
        <package android:name="org.localsend.localsend_app" />
    </queries>

    <!--
      usesCleartextTraffic="true": vlastní weby mohou být i http://
      (např. router nebo kamera v domácí síti).
      configChanges: připojení klávesnice/myši nesmí restartovat okna
      (prohlížeč by ztratil otevřenou stránku).
    -->
    <application
        android:allowBackup="true"
        android:theme="@style/BroZamTheme"
        android:label="BroZam TV"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/banner">

        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>
    </application>
</manifest>
